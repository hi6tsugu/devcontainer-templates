{
  "name": "Ubuntu + Claude Code + Node.js (npm)",
  "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
  "features": {
    // ホストと同じ UID の一般ユーザーがいると updateRemoteUserUID が効かないため、既存の一般ユーザーを削除
    "./features/delete-regular-users": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dcuser",
      "installZsh": false,
      "installOhMyZsh": false
    },
    // npm は Node.js 同梱の 11.19.0 を使用 (https://nodejs.org/dist/index.json で確認)
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.21.0",
      "pnpmVersion": "none"
    }
  },
  "overrideFeatureInstallOrder": [
    "./features/delete-regular-users",
    "ghcr.io/devcontainers/features/common-utils"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Claude Code の設定をリビルド後も保持
    "source=${localWorkspaceFolderBasename}--claude-config,target=/home/dcuser/.claude,type=volume",
    // node_modules をホストから分離
    "source=${localWorkspaceFolderBasename}--node-modules,target=/workspace/node_modules,type=volume"
  ],
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],
  "containerEnv": {
    // .claude.json の保存先を変更
    "CLAUDE_CONFIG_DIR": "/home/dcuser/.claude"
  },
  "remoteEnv": {
    // claude コマンドをパスに追加
    "PATH": "/home/dcuser/.local/bin:${containerEnv:PATH}"
  },
  "remoteUser": "dcuser",
  "initializeCommand": "sh \"${localWorkspaceFolder}/.devcontainer/initialize.sh\"",
  "postCreateCommand": "sh \"${containerWorkspaceFolder}/.devcontainer/post-create.sh\"",
  "postStartCommand": "sh \"${containerWorkspaceFolder}/.devcontainer/post-start.sh\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "EditorConfig.EditorConfig",
        "sohamkamani.code-eol"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
